    "db:setup": "sh -c 'set -a; for f in .env .env.local; do [ -f \"$f\" ] && . \"./$f\"; done; set +a; psql \"$TIGER_DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/authjs.sql -f db/schema.sql'"
  },
