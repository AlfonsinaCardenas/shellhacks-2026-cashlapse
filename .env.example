# Copy to .env and fill in. Never commit .env.
TIGER_DATABASE_URL=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL=gemini-3.8-flash
# Optional in development: leave all R2_* empty to store PDFs in .uploads/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
FRED_API_KEY=
BEA_API_KEY=
# Protects /api/cron/sync-cpi. Vercel sends it as "Authorization: Bearer <value>".
CRON_SECRET=
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
